generator client {
  provider = "prisma-client-js"
}

generator nestClient {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Role {
  id   String @id @default(uuid()) //primary key
  name String @unique

  users User[] //Relation to User 1:N
}

model User {
  id       String @id @default(uuid())
  email    String @unique
  password String

  roleId String //foreign key to Role
  role   Role   @relation(fields: [roleId], references: [id]) //Relation to Role 1:1

  createdAt DateTime @default(now())
}
